# Copy to .env for running fetch.py / backfill.py / migrate_sqlite.py locally.
# Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key bypasses row-level security. Keep it out of git and browsers.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
