{
  "expo": {
    "name": "Kerala Market",
    "slug": "kerala-market",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ff2000",
          "dark": {
            "backgroundColor": "#ff2000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff2000"
        }
      ]
    ],
    "android": {
      "package": "io.github.krixhnarr.keralamarket",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ff2000"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "io.github.krixhnarr.keralamarket",
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "0bc5de77-57f4-4bb9-87df-726cc6cdc10e"
      }
    },
    "owner": "andrewhugh"
  }
}
